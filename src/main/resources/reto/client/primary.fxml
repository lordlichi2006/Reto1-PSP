<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="360.0" minWidth="640.0" prefHeight="540.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="reto.client.MainController">

         <top>
            <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="IP:" />
                  <TextField fx:id="txtIpaddress" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="85.0" promptText="127.0.0.1" />
                  <Label text="Puerto:" />
                  <TextField fx:id="txtPort" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="85.0" promptText="5000" />
                  <Label text="Usuario:" />
                  <TextField fx:id="txtUsername" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="85.0" promptText="Usuario" />
            <Button fx:id="btnConnect" mnemonicParsing="false" text="Conectar" />
                  <Label fx:id="lblConnected" text="NO CONECTADO ○" textFill="#cc0055">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>

               </children>
            </HBox>
         </top>
         <center>
            <ScrollPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
              <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="200.0" />
              </content>
            </ScrollPane>
         </center>
   <bottom>
      <VBox prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
                  <HBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label fx:id="lblError" text="sample error" textFill="#cc0055">
                     <font>
                        <Font name="Consolas Italic" size="12.0" />
                     </font>
                  </Label>
                     </children>
                  </HBox>
            <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="40.0" prefWidth="960.0" spacing="10.0">
               <children>
                  <CheckBox fx:id="chkPrivateMessage" mnemonicParsing="false" text="Privado" />
                  <Label text="Para:" />
                  <TextField fx:id="txtPrivateMessageUsername" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="85.0" promptText="Admin" />
                  <TextField fx:id="txtMessage" maxWidth="1.7976931348623157E308" minWidth="120.0" prefWidth="256.0" promptText="Mensaje" />
                  <Button fx:id="btnConnect1" mnemonicParsing="false" text="Enviar Mensaje" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
